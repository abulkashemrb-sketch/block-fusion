# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Gradle writes here even though Flutter redirects the main output to /build
/android/build/
/android/.gradle/
/android/local.properties

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Vercel's project link. It also gets written inside build/web by a
# `vercel deploy build/web`, where it then survives rebuilds and quietly
# re-links a later deploy to whatever project it names.
.vercel/

# Local dev tooling / private notes (not part of the shipped app)
.mcp.json
PROJECT_HANDOFF.md
PROJECT_INFO.md

# Secrets. Never commit these — the Supabase access token and database
# password in here grant real access to the project.
SUPABASE_CREDENTIALS.md
.env
.env.*
!.env.example

# Per-developer Claude Code settings (.claude/settings.json is shared on purpose)
.claude/settings.local.json
